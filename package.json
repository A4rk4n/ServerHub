{
  "name": "server-hub",
  "version": "2.11.1",
  "description": "Local desktop manager for real dedicated game-server processes",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Server Hub contributors",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:server": "next build && node scripts/prepare-standalone.mjs",
    "dist:win:portable": "npm run build:server && node scripts/build-windows-portable.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:installation-jobs": "node scripts/test-installation-jobs.mjs",
    "test:package-integrity": "node scripts/test-package-integrity.mjs",
    "test:release-verification": "node scripts/test-release-verification.mjs",
    "test:recovery-invariants": "node scripts/test-recovery-invariants.mjs",
    "test:security": "tsx scripts/test-security.ts",
    "test:extraction": "tsx --require ./scripts/register-better-sqlite3-stub.cjs scripts/test-extraction.ts",
    "test:migrations": "tsx --require ./scripts/register-better-sqlite3-stub.cjs scripts/test-migrations.ts",
    "test": "npm run typecheck && npm run lint && npm run test:security && npm run test:extraction && npm run test:backup-validation && npm run test:support-bundle && npm run test:server-templates && npm run test:tool-security && npm run test:installation-diagnostics && npm run test:provider-preflight && npm run test:readiness-policy && npm run test:firewall-diagnostics && npm run test:managed-process && npm run test:recovery-history && npm run test:installation-report && npm run test:host-platform && npm run test:tool-usage && npm run test:authenticode && npm run test:tool-repair-failures && npm run test:server-activation && npm run test:update-validation && npm run test:update-recovery && npm run test:manual-update-rollback && npm run test:maintenance-lifecycle && npm run test:shutdown-lifecycle && npm run test:query-protocols && npm run test:a2s-players && npm run test:player-observations && npm run test:moderation && npm run test:scheduled-actions && npm run test:calendar-schedule && npm run test:minecraft-status && npm run test:migrations && npm run test:migration-matrix && npm run test:installation-jobs && npm run test:package-integrity && npm run test:release-verification",
    "sbom": "node scripts/generate-sbom.mjs",
    "test:catalog": "tsx scripts/test-catalog.ts",
    "test:backup-validation": "tsx scripts/test-backup-validation.ts",
    "test:support-bundle": "tsx scripts/test-support-bundle.ts",
    "test:server-templates": "tsx scripts/test-server-templates.ts",
    "test:migration-matrix": "tsx --require ./scripts/register-better-sqlite3-stub.cjs scripts/test-migration-matrix.ts",
    "test:shutdown-lifecycle": "node scripts/test-shutdown-lifecycle.mjs",
    "test:query-protocols": "tsx scripts/test-query-protocols.ts",
    "test:minecraft-status": "tsx scripts/test-minecraft-status.ts",
    "test:a2s-players": "tsx scripts/test-a2s-players.ts",
    "test:player-observations": "tsx scripts/test-player-observations.ts",
    "test:moderation": "tsx scripts/test-moderation.ts",
    "test:scheduled-actions": "tsx scripts/test-scheduled-actions.ts",
    "test:calendar-schedule": "tsx scripts/test-calendar-schedule.ts",
    "test:tool-security": "tsx scripts/test-tool-security.ts",
    "test:tool-repair-failures": "tsx scripts/test-tool-repair-failures.ts",
    "test:authenticode": "tsx scripts/test-authenticode.ts",
    "test:tool-usage": "tsx scripts/test-tool-usage.ts",
    "test:host-platform": "tsx scripts/test-host-platform.ts",
    "test:installation-diagnostics": "tsx scripts/test-installation-diagnostics.ts",
    "test:installation-report": "tsx scripts/test-installation-report.ts",
    "test:managed-process": "tsx scripts/test-managed-process.ts",
    "test:recovery-history": "tsx scripts/test-recovery-history.ts",
    "test:provider-preflight": "tsx scripts/test-provider-preflight.ts",
    "test:firewall-diagnostics": "tsx scripts/test-firewall-diagnostics.ts",
    "test:readiness-policy": "tsx scripts/test-readiness-policy.ts",
    "test:server-activation": "tsx scripts/test-server-activation.ts",
    "test:update-validation": "tsx scripts/test-update-validation.ts",
    "test:maintenance-lifecycle": "tsx scripts/test-maintenance-lifecycle.ts",
    "test:manual-update-rollback": "tsx scripts/test-manual-update-rollback.ts",
    "test:update-recovery": "tsx scripts/test-update-recovery.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "13.4.4",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tar": "7.5.22",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/archiver": "8.0.0",
    "@typescript-eslint/parser": "8.71.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "archiver": "^8.0.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "postject": "1.0.0-alpha.6",
    "resedit": "3.1.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10 <11"
  }
}
